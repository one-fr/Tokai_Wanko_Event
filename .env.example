# ローカル手動実行用の環境変数テンプレート。
# `cp .env.example .env` して値を埋めてから `npm run dry-run` / `npm run dev` で実行する。
# 変数名・内容はGitHub Secretsと同一。

# Claude APIキー（https://console.claude.com）
# Web検索もClaudeのサーバー側ツールで行うため、検索用のキーは不要
ANTHROPIC_API_KEY=

# --- 以下2つは DRY_RUN=1 でのドライラン時は不要 ---

# Calendar連携用サービスアカウントのJSONキー。
# Nodeの --env-file は複数行の値を先頭行で打ち切るため、必ずbase64の1行文字列にすること:
#   base64 -i ~/Downloads/<key>.json | tr -d '\n' | pbcopy
GOOGLE_SERVICE_ACCOUNT_KEY=

# 登録先カレンダーのID（....@group.calendar.google.com）
GOOGLE_CALENDAR_ID=
